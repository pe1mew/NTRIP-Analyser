{
    "version": "2.0.0",
    // One build system. The hand-listed gcc lines that stood here (and
    // build-gui.bat / build-gui.ps1 beside them) retired with the TLS
    // rollout: a second source list is a second place to forget a file,
    // and CMakeLists.txt owns the only list now.
    "tasks": [
        {
            "label": "Configure (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "detail": "Run after changing CMakeLists.txt or refreshing a vendored library"
        },
        {
            "label": "Build (CMake)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "-j"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "detail": "CLI, GUI and tests; binaries land in bin/"
        },
        {
            "label": "Test (ctest)",
            "type": "shell",
            "command": "ctest",
            "args": ["--test-dir", "build", "--output-on-failure"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "detail": "The full suite, as CI runs it"
        }
    ]
}
