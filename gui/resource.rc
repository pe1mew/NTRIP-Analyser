/**
 * @file resource.rc
 * @brief Windows resource script for NTRIP-Analyser GUI
 */

#include <winres.h>
#include "resource.h"
#include "core/version.h"

/* ── Menu Bar ─────────────────────────────────────────────── */
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Load Configuration...\tCtrl+O",  IDM_FILE_LOAD_CONFIG
        MENUITEM "&Save Configuration...\tCtrl+S",  IDM_FILE_SAVE_CONFIG
        MENUITEM "&Generate Template Config",        IDM_FILE_GENERATE
        MENUITEM SEPARATOR
        MENUITEM "Load &Ephemerides (RINEX)...",     IDM_FILE_LOAD_EPH
        MENUITEM "Save Sky &Plot as PNG...",         IDM_FILE_SAVE_SKYPLOT
        MENUITEM "&Export Statistics...",             IDM_FILE_EXPORT_STATS
        MENUITEM SEPARATOR
        MENUITEM "Start &RTCM Capture...",           IDM_FILE_RTCM_START
        MENUITEM "Stop RTCM Capture",                IDM_FILE_RTCM_STOP
        MENUITEM "Replay RTCM File...",              IDM_FILE_RTCM_REPLAY
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",                   IDM_FILE_EXIT
    END
    POPUP "&Connection"
    BEGIN
        MENUITEM "Get &Mountpoints\tCtrl+M",         IDM_CONN_MOUNTPOINTS
        MENUITEM "&Open Stream\tCtrl+D",              IDM_CONN_OPEN_STREAM
        MENUITEM SEPARATOR
        MENUITEM "&Close Stream\tEsc",                 IDM_CONN_CLOSE_STREAM
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Sky Plot...",                      IDM_VIEW_SKY_PLOT
        MENUITEM "&VRS Monitor...",                   IDM_VIEW_VRS_MONITOR
        MENUITEM "Signal &Quality...",                IDM_VIEW_SIGNAL_QUALITY
        MENUITEM "Session &History...",               IDM_VIEW_HISTORY
    END
    POPUP "&Tools"
    BEGIN
        MENUITEM "Toggle &auto-send GGA",             IDM_TOOLS_VRS_GGA_TOGGLE
        MENUITEM "Auto-&reconnect on drop",           IDM_TOOLS_AUTO_RECONNECT
        MENUITEM "&Minimise to notification area",    IDM_TOOLS_TRAY_MINIMIZE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About NTRIP-Analyser",              IDM_HELP_ABOUT
        MENUITEM "View on &GitHub",                    IDM_HELP_GITHUB
    END
END

/* ── Visual Styles Manifest (ComCtl32 v6) ─────────────────── */
/* This enables modern themed controls (XP+ visual styles)     */
1 24 "gui/ntrip-gui.exe.manifest"

/* ── Version Information ──────────────────────────────────────
 * Values come from src/core/version.h so the GUI, CLI, service and
 * Android app cannot drift apart.  windres resolves these macros; the
 * header is deliberately free of #includes and types so it can. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION NTRIP_VERSION_RC
 PRODUCTVERSION NTRIP_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      NTRIP_COMPANY_NAME
            VALUE "FileDescription",  "NTRIP RTCM 3.x Stream Analyser - GUI"
            VALUE "FileVersion",      NTRIP_VERSION_RC_STR
            VALUE "InternalName",     NTRIP_ARTEFACT_GUI
            VALUE "LegalCopyright",   "Copyright (C) Remko Welling, PE1MEW"
            VALUE "OriginalFilename", "ntrip-analyser-gui.exe"
            VALUE "ProductName",      NTRIP_PRODUCT_NAME
            VALUE "ProductVersion",   NTRIP_VERSION_RC_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
