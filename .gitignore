*.exe
*.json

# bin/ is the output directory for every build system -- CMake, the VS
# Code tasks and build-gui.bat all write executables here, and configs
# and captures naturally sit beside them.  Ignore the lot except the
# placeholder that makes git create the directory at all: without it a
# fresh clone has no bin/ and every non-CMake build fails on "No such
# file or directory".
#
# Needed on top of *.exe because the Linux binaries carry no extension.
bin/*
!bin/readme.md
!bin/exampleConfig.json

# Build artifacts
gui_main.o
build_output.txt


# Service build artifacts
service/ntrip-monitord
service/ntrip-monitord.exe
!service/monitord.example.json

# CMake build directories.  The glob covers ad-hoc names too -- build/,
# build-win/, build-rel/ -- so a new build directory is never accidentally
# committed by a `git add -A`.
build*/

# Release packaging output (`cmake --build <dir> --target release`)
dist/
_pkg/

# Claude Code session state and worktrees
.claude/

# ── Android ──────────────────────────────────────────────────────────
# Gradle and the NDK write large trees; local.properties names this
# machine's SDK path and must never be committed.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.cxx/
android/app/.cxx/
*.apk
