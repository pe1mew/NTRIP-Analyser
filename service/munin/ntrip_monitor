#!/bin/sh
# ntrip_monitor -- Munin multigraph plugin for NTRIP-Analyser's monitord.
#
# Reads the per-mountpoint JSON that ntrip-monitord writes and prints
# Munin multigraph config/values.  The plugin holds no connection and
# does no computation: munin-node invokes plugins every five minutes and
# expects an answer in seconds, which is why the daemon exists
# (design/architecture.md par. 5.1).
#
# Two documents per mountpoint, and they answer different questions:
#
#   <mount>.json          a snapshot -- what is true this instant
#   <mount>.report.json   the tier-2 stability report over a rolling
#                         window -- whether the station has *been* fit
#
# The parsing here is NOT a general JSON parser.  It reads the flat
# single-line documents produced by ns_stats_to_json() and sr_to_json(),
# whose exact shape this project controls (src/core/ns_stats.c,
# src/core/station_report.c).  Every key it extracts is a unique
# top-level scalar, or an element of the "types" array in the fixed
# order the serialiser emits.
#
# Field names are a published contract: Munin has no version negotiation,
# and renaming a field silently orphans its RRD history.  Treat every
# field name in this file as frozen (design/architecture.md par. 7.3).
#
# Configuration (via munin plugin-conf.d):
#   [ntrip_monitor]
#   env.statedir /var/lib/ntrip-monitor
#   env.stale    120
#
# stale: snapshots older than this many seconds are reported as U
# (undefined).  Reporting the last known values instead would draw a
# flat, healthy-looking line while the daemon is down -- exactly the
# wrong failure mode for a monitor.
#
# Project: NTRIP-Analyser
# License: Apache License 2.0 with Commons Clause

STATEDIR="${statedir:-/var/lib/ntrip-monitor}"
STALE="${stale:-120}"

# scalar <file> <key> -> value, or "U" if absent/null
scalar() {
    # Keys are unique top-level scalars in our own serialiser's output.
    v=$(sed -n 's/.*"'"$2"'":\([^,}]*\).*/\1/p' "$1" | head -1)
    case "$v" in
        ""|null) echo "U" ;;
        \"*)     echo "$v" | tr -d '"' ;;
        *)       echo "$v" ;;
    esac
}

# report_file <snapshot> -> the tier-2 report written beside it
report_file() {
    echo "${1%.json}.report.json"
}

# is_stale <file> -> 0 (stale) / 1 (fresh)
is_stale() {
    now=$(date +%s)
    mtime=$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0)
    [ $((now - mtime)) -gt "$STALE" ]
}

# type_frames <file> -> lines of "<msgtype> <frames>"
type_frames() {
    awk '{
        if (!match($0, /"types":\[/)) exit
        s = substr($0, RSTART + RLENGTH)
        d = 1
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (c == "[") d++
            if (c == "]") { d--; if (d == 0) { s = substr(s, 1, i - 1); break } }
        }
        n = split(s, recs, /\},\{/)
        for (r = 1; r <= n; r++) {
            if (match(recs[r], /"type":[0-9]+/)) {
                t = substr(recs[r], RSTART + 7, RLENGTH - 7)
                if (match(recs[r], /"frames":[0-9]+/)) {
                    f = substr(recs[r], RSTART + 9, RLENGTH - 9)
                    print t, f
                }
            }
        }
    }' "$1"
}

emit_config() {
    f="$1"; name="$2"; mount="$3"

    cat <<EOF
multigraph ntrip_throughput_${name}
graph_title NTRIP ${mount} throughput
graph_category ntrip
graph_vlabel bytes/s
graph_args --base 1024 -l 0
bytes_per_s.label throughput
bytes_per_s.type GAUGE
bytes_per_s.min 0

multigraph ntrip_integrity_${name}
graph_title NTRIP ${mount} frame integrity
graph_category ntrip
graph_vlabel frames/s
crc_error.label CRC-24Q errors
crc_error.type DERIVE
crc_error.min 0
crc_error.warning 1
resyncs.label framing re-syncs
resyncs.type DERIVE
resyncs.min 0

multigraph ntrip_satellites_${name}
graph_title NTRIP ${mount} satellites tracked
graph_category ntrip
graph_vlabel satellites
sats_total.label satellites
sats_total.type GAUGE
sats_total.min 0

multigraph ntrip_cnr_${name}
graph_title NTRIP ${mount} mean C/N0
graph_category ntrip
graph_vlabel dB-Hz
cnr_mean.label mean C/N0
cnr_mean.type GAUGE
cnr_mean.warning 35:

multigraph ntrip_iono_${name}
graph_title NTRIP ${mount} ionosphere (ROTI)
graph_category ntrip
graph_vlabel TECU/min
graph_info Rate of TEC Index from dual-frequency carrier phase. Under 0.5 is quiet, over 1.0 disturbed. Requires MSM7 with two frequencies; reads U on single-frequency streams.
roti_median.label median ROTI
roti_median.type GAUGE
roti_median.warning :0.5
roti_median.critical :1.0
roti_max.label worst satellite
roti_max.type GAUGE

multigraph ntrip_availability_${name}
graph_title NTRIP ${mount} availability
graph_category ntrip
graph_vlabel state
connected.label connected (1 = yes)
connected.type GAUGE
connected.critical 1:1
reconnects.label reconnects
reconnects.type DERIVE
reconnects.min 0

multigraph ntrip_msgrate_${name}
graph_title NTRIP ${mount} message rate per type
graph_category ntrip
graph_vlabel frames/s
EOF
    type_frames "$f" | while read -r t frames; do
        echo "type_${t}.label RTCM ${t}"
        echo "type_${t}.type DERIVE"
        echo "type_${t}.min 0"
    done

    # Tier 2.  Only when the daemon is publishing reports: an older one
    # is not, and a graph family of nothing but undefined values is
    # worse than an absent one.
    r=$(report_file "$f")
    [ -f "$r" ] || return 0

    cat <<EOF

multigraph ntrip_stability_${name}
graph_title NTRIP ${mount} stability (tier 2)
graph_category ntrip
graph_vlabel verdict
graph_args --lower-limit 0 --upper-limit 3 --rigid
graph_info Stability over a rolling window of hours -- a different question from the rest of these graphs, which describe this instant. 0 = insufficient evidence (the window is not yet long enough to judge, which is the honest answer for the first ten minutes of every session), 1 = stable, 2 = degraded, 3 = unstable. A metric that cannot be measured reads U rather than 0, so "not applicable" is never drawn as "fine". Thresholds: degraded warns, unstable is critical; insufficient evidence never alerts.
EOF
    for m in availability integrity signal satellites ionosphere delivery; do
        echo "${m}.label ${m}"
        echo "${m}.type GAUGE"
        echo "${m}.min 0"
        echo "${m}.max 3"
        echo "${m}.warning 0:1"
        echo "${m}.critical 0:2"
    done
}

emit_values() {
    f="$1"; name="$2"

    if is_stale "$f"; then
        # The daemon has stopped writing.  Everything is U: a stale
        # "connected:true" must not keep a green light on.
        bytes="U"; crc="U"; resyncs="U"
        sats="U"; cnr="U"; conn="U"; reconn="U"
        roti_med="U"; roti_max="U"
    else
        bytes=$(scalar "$f" bytes_per_s)
        crc=$(scalar "$f" frames_crc_error)
        resyncs=$(scalar "$f" framing_resyncs)
        sats=$(scalar "$f" sats_total)
        cnr=$(scalar "$f" cnr_mean_all)
        roti_med=$(scalar "$f" iono_roti_median)
        roti_max=$(scalar "$f" iono_roti_max)
        reconn=$(scalar "$f" reconnects)
        case "$(scalar "$f" connected)" in
            true)  conn=1 ;;
            false) conn=0 ;;
            *)     conn="U" ;;
        esac
    fi

    cat <<EOF
multigraph ntrip_throughput_${name}
bytes_per_s.value ${bytes}

multigraph ntrip_integrity_${name}
crc_error.value ${crc}
resyncs.value ${resyncs}

multigraph ntrip_satellites_${name}
sats_total.value ${sats}

multigraph ntrip_cnr_${name}
cnr_mean.value ${cnr}

multigraph ntrip_iono_${name}
roti_median.value ${roti_med}
roti_max.value ${roti_max}

multigraph ntrip_availability_${name}
connected.value ${conn}
reconnects.value ${reconn}

multigraph ntrip_msgrate_${name}
EOF
    if is_stale "$f"; then
        type_frames "$f" | while read -r t frames; do
            echo "type_${t}.value U"
        done
    else
        type_frames "$f" | while read -r t frames; do
            echo "type_${t}.value ${frames}"
        done
    fi

    r=$(report_file "$f")
    [ -f "$r" ] || return 0

    echo ""
    echo "multigraph ntrip_stability_${name}"
    for m in availability integrity signal satellites ionosphere delivery; do
        # Staleness is judged on the report's own file: it is written on
        # the same interval, so an old one means the same thing here as
        # there -- the daemon has stopped, and a verdict it can no longer
        # support must not keep a green line on the graph.
        if is_stale "$r"; then
            echo "${m}.value U"
        else
            echo "${m}.value $(scalar "$r" "${m}_verdict")"
        fi
    done
}

# ── Main ────────────────────────────────────────────────────────────

found=0
for f in "$STATEDIR"/*.json; do
    [ -f "$f" ] || continue
    # The reports are read through their snapshots, never on their own:
    # one station is one set of graph families, whichever files it takes
    # to fill them.
    case "$f" in *.report.json) continue ;; esac
    # Only snapshots: anything ns_stats_to_json() wrote carries a
    # schema_version.  A stray JSON file (a config, a note) must not
    # invent a graph family.  A report carries report_schema_version and
    # so fails this test too, which is why it has that name.
    [ "$(scalar "$f" schema_version)" = "U" ] && continue
    found=1
    base=$(basename "$f" .json)
    # Munin field/graph names: [A-Za-z0-9_] only.
    name=$(echo "$base" | tr -c 'A-Za-z0-9_' '_' | sed 's/_*$//')
    mount=$(scalar "$f" mountpoint)
    [ "$mount" = "U" ] && mount="$base"

    case "$1" in
        config) emit_config "$f" "$name" "$mount" ;;
        *)      emit_values "$f" "$name" ;;
    esac
done

if [ "$found" = "0" ]; then
    echo "# no snapshots in $STATEDIR -- is ntrip-monitord running?" >&2
    exit 1
fi
exit 0
