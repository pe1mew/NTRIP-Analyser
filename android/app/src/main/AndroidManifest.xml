<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- A KPI run needs sixty continuous seconds, longer than a
         backgrounded activity may keep a socket open, so the run lives
         in a foreground service.  dataSync is its type: it maintains a
         network stream on the user's behalf.

         Android 15 allows a dataSync service about six hours in a day
         and then calls Service.onTimeout(); MonitorService handles it,
         because an unhandled one is a crash rather than an ending. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The sky view places satellites from this phone's own GNSS.
         Requested when that view is first opened, not at launch: the
         station check itself needs no location at all. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps"
                  android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NtripAnalyser">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hands one shared plot to the app the user picked, and nothing
          else: the declared paths are a single cache directory, and the
          receiving app gets a one-shot read grant on the file named in
          the intent. exported=false with grantUriPermissions is the
          combination meaning "not open to the world, openable by
          whoever I hand a URI to".

          The authority carries the applicationId, so free and pro do
          not collide when both are installed, which on this project's
          test phone they are.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
