# Release signing — copy to keystore.properties and fill in.
#
# keystore.properties is git-ignored, and so is any *.jks or *.keystore
# in this tree. Keep the keystore itself OUTSIDE the repository: a
# backed-up working copy is a backed-up signing key.
#
# Create one (once, and once only):
#
#   keytool -genkeypair -v -keystore /path/outside/repo/ntrip-analyser.jks \
#           -alias ntrip-analyser -keyalg RSA -keysize 4096 -validity 10000
#
# keytool prompts for the passwords; run it yourself, in your own
# terminal, so they are never typed anywhere they could be recorded.
#
# **This key is the app's identity on Play, for its whole life.** Lose it
# and the listing cannot be updated -- not by you, not by Google, not
# ever; the only remedy is a new listing under a new package name,
# leaving every existing install stranded. Back it up somewhere that
# survives this machine, and store the passwords in a password manager.
#
# Both editions are signed with the same key. They are one project with
# two Play listings, and nothing is gained by two keys to keep safe.
#
# If Play App Signing is enabled (it is, for new apps), this key is the
# *upload* key: Google holds the app signing key and can reset an upload
# key that is lost. That reduces the disaster to an inconvenience, but
# only if the account itself is protected -- it does not make the
# backup optional.

storeFile=../../secrets/ntrip-analyser.jks
storePassword=
keyAlias=ntrip-analyser
keyPassword=
